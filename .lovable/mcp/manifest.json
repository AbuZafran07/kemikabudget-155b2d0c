{
  "version": 1,
  "sdk_version": "3.1.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yjwokrecbsorkwukiohi.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "budget-expense",
      "version": "0.1.0",
      "title": "Budget Expense"
    },
    "tools": [
      {
        "name": "list_requests",
        "title": "List expense requests",
        "description": "Read a page of expense request summaries allowed by the signed-in user’s permissions; excludes beneficiary and attachment data.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "submitted",
                "under_review",
                "approved",
                "paid",
                "settled",
                "rejected",
                "cancelled"
              ],
              "description": "Optional request status filter."
            },
            "division_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional division ID, subject to your access permissions."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0,
              "description": "Number of records to skip."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum number of summaries to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_budgets",
        "title": "List division budgets",
        "description": "Read allocated, used and remaining division budgets within the signed-in user’s permissions, optionally filtered by period.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "division_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional accessible division ID."
            },
            "period_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional budget period ID."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0,
              "description": "Number of records to skip."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum number of budget rows to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
